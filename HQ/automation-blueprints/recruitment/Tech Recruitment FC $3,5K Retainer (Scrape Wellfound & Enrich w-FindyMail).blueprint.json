        {
            "id": 4,
            "module": "azure-openai:createAChatCompletion",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 4299534
            },
            "filter": {
                "name": "Email Exists & Valid?",
                "conditions": [
                    [
                        {
                            "a": "{{3.contact.email}}",
                            "o": "exist"
                        }
                    ]
                ]
            },
            "mapper": {
                "messages": [
                    {
                        "role": "user",
                        "content": [
                            {
                                "text": "You must return exactly this format:\r\nSaw [company_name] just posted for a [job_title] [timing] - [growth_signal].\r\n\r\nAre you handling all the [department] recruitment internally, or open to specialist support for these [level] roles?\r\n\r\nRules:\r\n- Keep it conversational, not corporate\r\n- [timing] = \"yesterday\" or \"this week\" \r\n- [growth_signal] = simple observation about scaling/growth\r\n- [department] = sales, marketing, engineering\r\n- [level] = senior, executive, high-level\r\n\r\nPERFECT EXAMPLE:\r\nSaw Ambient.ai just posted for a Regional Sales Manager yesterday - you guys are clearly scaling the sales team aggressively.\r\n\r\nAre you handling all the sales recruitment internally, or open to specialist support for these senior roles?\"\r\n\r\nData:\r\nCompany: {{1.company.name}}\r\nJob: {{1.job_title}}\r\nPosted: {{1.job_listing_posted}}\r\nFunding: {{1.company.totaly_raised}}",
                                "type": "text"
                            }
                        ]
                    }
                ],
                "temperature": "1",
                "deploymentName": "gpt-4o"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0,
                    "name": "Anti-fragile method"
                },
                "restore": {
                    "expect": {
                        "stop": {
                            "mode": "chose"
                        },
                        "messages": {
                            "mode": "chose",
                            "items": [
                                {
                                    "role": {
                                        "mode": "chose",
                                        "label": "User"
                                    },
                                    "content": {
                                        "mode": "chose",
                                        "items": [
                                            {
                                                "type": {
                                                    "mode": "chose",
                                                    "label": "Text"
                                                }
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                        "logit_bias": {
                            "mode": "chose"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "azure-openai3"
                            },
                            "label": "My Azure OpenAI API Key (advanced) connection"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:azure-openai2,azure-openai3",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "deploymentName",
                        "type": "text",
                        "label": "OpenAI Deployment Name",
                        "required": true
                    },
                    {
                        "name": "messages",
                        "spec": {
                            "name": "value",
                            "spec": [
                                {
                                    "name": "role",
                                    "type": "select",
                                    "label": "Role",
                                    "options": [
                                        {
                                            "label": "System",
                                            "value": "system",
                                            "nested": [
                                                {
                                                    "help": "The contents of the message. This parameter is required except for `Assistant` role with function calls.",
                                                    "name": "content",
                                                    "type": "text",
                                                    "label": "Message Content",
                                                    "required": true
                                                }
                                            ]
                                        },
                                        {
                                            "label": "User",
                                            "value": "user",
                                            "nested": [
                                                {
                                                    "name": "content",
                                                    "spec": {
                                                        "spec": [
                                                            {
                                                                "help": "`Image` is supported by only GPT-4 Turbo with Vision model.",
                                                                "name": "type",
                                                                "type": "select",
                                                                "label": "Type",
                                                                "options": [
                                                                    {
                                                                        "label": "Text",
                                                                        "value": "text",
                                                                        "nested": [
                                                                            {
                                                                                "name": "text",
                                                                                "type": "text",
                                                                                "label": "Text",
                                                                                "required": true
                                                                            }
                                                                        ],
                                                                        "default": true
                                                                    },
                                                                    {
                                                                        "label": "Image",
                                                                        "value": "image_url",
                                                                        "nested": [
                                                                            {
                                                                                "name": "image_url",
                                                                                "spec": [
                                                                                    {
                                                                                        "name": "url",
                                                                                        "type": "text",
                                                                                        "label": "URL",
                                                                                        "required": true
                                                                                    },
                                                                                    {
                                                                                        "name": "detail",
                                                                                        "type": "select",
                                                                                        "label": "Detail",
                                                                                        "options": [
                                                                                            {
                                                                                                "label": "High",
                                                                                                "value": "high"
                                                                                            },
                                                                                            {
                                                                                                "label": "Low",
                                                                                                "value": "low"
                                                                                            },
                                                                                            {
                                                                                                "label": "Auto",
                                                                                                "value": "auto"
                                                                                            }
                                                                                        ]
                                                                                    }
                                                                                ],
                                                                                "type": "collection",
                                                                                "label": "Image URL"
                                                                            }
                                                                        ]
                                                                    }
                                                                ],
                                                                "mappable": false,
                                                                "required": true
                                                            }
                                                        ],
                                                        "type": "collection",
                                                        "label": "Content"
                                                    },
                                                    "type": "array",
                                                    "label": "Content",
                                                    "labels": {
                                                        "add": "Add content"
                                                    },
                                                    "required": true
                                                }
                                            ]
                                        },
                                        {
                                            "label": "Assistant",
                                            "value": "assistant",
                                            "nested": [
                                                {
                                                    "help": "The contents of the message. This parameter is required except for `Assistant` role with function calls.",
                                                    "name": "content",
                                                    "type": "text",
                                                    "label": "Message Content",
                                                    "required": true
                                                }
                                            ]
                                        }
                                    ],
                                    "required": true
                                }
                            ],
                            "type": "collection",
                            "label": "Message"
                        },
                        "type": "array",
                        "label": "Messages",
                        "required": true
                    },
                    {
                        "name": "max_tokens",
                        "type": "number",
                        "label": "Max Tokens",
                        "validate": {
                            "min": 0
                        }
                    },
                    {
                        "name": "temperature",
                        "type": "number",
                        "label": "Temperature",
                        "validate": {
                            "max": 2,
                            "min": 0
                        }
                    },
                    {
                        "name": "top_p",
                        "type": "number",
                        "label": "Top P",
                        "validate": {
                            "max": 1,
                            "min": 0
                        }
                    },
                    {
                        "name": "n",
                        "type": "number",
                        "label": "Number of Completions"
                    },
                    {
                        "name": "frequency_penalty",
                        "type": "number",
                        "label": "Frequency Penalty",
                        "validate": {
                            "max": 2,
                            "min": -2
                        }
                    },
                    {
                        "name": "presence_penalty",
                        "type": "number",
                        "label": "Presence Penalty",
                        "validate": {
                            "max": 2,
                            "min": -2
                        }
                    },
                    {
                        "name": "logit_bias",
                        "spec": {
                            "name": "value",
                            "spec": [
                                {
                                    "name": "token",
                                    "type": "text",
                                    "label": "Token",
                                    "required": true
                                },
                                {
                                    "name": "probability",
                                    "type": "number",
                                    "label": "Probability",
                                    "required": true,
                                    "validate": {
                                        "max": 100,
                                        "min": -100
                                    }
                                }
                            ],
                            "type": "collection",
                            "label": "Token Probability"
                        },
                        "type": "array",
                        "label": "Token Probability"
                    },
                    {
                        "name": "stop",
                        "spec": {
                            "name": "value",
                            "spec": [
                                {
                                    "type": "text"
                                }
                            ],
                            "type": "text",
                            "label": "Sequence"
                        },
                        "type": "array",
                        "label": "Stop Sequences",
                        "validate": {
                            "maxItems": 4
                        }
                    }
                ]
            }
        },
